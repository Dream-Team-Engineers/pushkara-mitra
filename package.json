{
  "name": "pushkara-mitra",
  "version": "0.0.0",
  "private": true,
  "description": "Independent, Telugu-first, offline-capable pilgrim assistance PWA for the Godavari Pushkaralu 2027. Not an official application.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licence-check": "node scripts/licence-check.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^5.0.5",
    "eslint": "^10.14.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
