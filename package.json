{
  "name": "pushkara-mitra",
  "version": "1.9.1",
  "private": true,
  "description": "Independent, Telugu-first, offline-capable pilgrim assistance PWA for the Godavari Pushkaralu 2027. Not an official application.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "budget:web": "node scripts/measure-web-bundle.mjs",
    "smoke:web": "node scripts/smoke-web.mjs dist/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licence-check": "node scripts/licence-check.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "test:routing": "node scripts/test-routing.mjs",
    "review:official": "node scripts/build-official-review.mjs",
    "review:ghats-draft": "node scripts/build-ghats-draft.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/snapshot": "^5.1.0",
    "eslint": "^10.14.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2"
  }
}
